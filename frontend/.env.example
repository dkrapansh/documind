# Server-only (no VITE_ prefix, so it's never inlined into the client
# bundle) - used exclusively by the proxy functions in api/.
DOCUMIND_API_BASE=https://documind-oyhv.onrender.com

# Must match the backend's DEMO_PROXY_SHARED_SECRET exactly. Lets the
# backend trust the visitor IP this proxy forwards on POST
# /auth/demo-session, instead of falling back to a shared bucket keyed
# on Vercel's own egress IP. Leaving this unset still works locally, it
# just means the backend rate-limits every request from this proxy as
# if it were one caller.
DOCUMIND_PROXY_SHARED_SECRET=change-me-to-a-long-random-value
