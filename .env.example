DATABASE_URL=postgresql+psycopg://documind:your_password@localhost:5433/documind
APP_ENV=development
GEMINI_API_KEY=your-gemini-api-key-here
# Comma-separated allowlist for browser CORS. Add the deployed frontend's
# origin alongside localhost:5173 once it's hosted.
FRONTEND_ORIGINS_RAW=http://localhost:5173
# Must match the frontend proxy's DOCUMIND_PROXY_SHARED_SECRET exactly.
# Leave unset for local dev; POST /auth/demo-session's rate limiter just
# falls back to rate-limiting by raw TCP peer address instead of a
# proxy-forwarded visitor IP.
DEMO_PROXY_SHARED_SECRET=change-me-to-a-long-random-value
# OAuth Client ID from Google Cloud Console (Credentials -> OAuth client ID).
# Leave unset to disable POST /auth/google entirely - it 401s every request
# instead of accepting tokens meant for a different app.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com